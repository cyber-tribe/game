{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // tools/audio/*.tsはnode組み込みの型剥がし実行(`node tools/audio/build.ts`)を
    // 前提にしており、相対importに明示的な.ts拡張子が要る(plan/audio-synthesis.md)
    "allowImportingTsExtensions": true
  },
  "include": ["src", "tests", "tools/audio", "tools/preview-harness.ts", "vite.config.ts", "capacitor.config.ts"]
}
