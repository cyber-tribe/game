{
  "name": "garudo-dungeon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "少年ガルドと迷いの洞窟 — 不思議のダンジョン型 3D ローグライク",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "models": "tools/venv/bin/python tools/build_models.py",
    "playtest": "node tools/playtest.mjs",
    "auto-tester": "node tools/auto-tester.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12"
  }
}
